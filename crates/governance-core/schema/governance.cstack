// Governance registry + connector schema (ADR-0009: cratestack only).
//
// This file is the SOURCE OF TRUTH for the tables, the migrations, the CRUD
// layer and the REST routes. There is no hand-written SQL and no hand-written
// migration anywhere in this workspace. Anything the generated CRUD cannot
// express belongs in a `procedure` below -- not in a second persistence path.
//
// Money is ALWAYS micro-USD (ADR-0008). cratestack's `Int` maps to Rust `i64`,
// so a micro-USD amount is safe at any budget we will ever hold; never model a
// monetary value as `Decimal` or `Float` here.
//
// `tenantId` is on every model. A deployment serves ONE tenant (ADR-0001) --
// the column exists so our install and a customer's run the identical schema,
// and so every query has one thing to filter on.

// REST, not RPC: resource-shaped routes, standard verbs (ADR-0009).
transport rest

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Principal {
  id String
}

// `@readonly` on both: neither must ever appear in a generated create or
// update input (matching `Integration.credentialHash`'s existing pattern) --
// without it, a normal PATCH could rewrite a row's own audit history.
// `updatedAt` still won't advance on its own from this alone (`@readonly`
// only controls generated input, not DDL) -- see the migration's
// `touch_updated_at` trigger, hand-added for the same reason (#21).
mixin AuditFields {
  createdAt DateTime @default(dbgenerated()) @readonly
  updatedAt DateTime @default(dbgenerated()) @readonly
}

// ────────────────────────────────────────────────────────────────────────────
// Registry (ADR-0005) -- built before either connector, because retrofitting
// `tenantId` under existing tables means rewriting every primary key.
// ────────────────────────────────────────────────────────────────────────────

model Tenant {
  @use(AuditFields)

  id String @id
  name String

  applications Application[] @relation(fields:[id],references:[tenantId])
  environments Environment[] @relation(fields:[id],references:[tenantId])
  integrations Integration[] @relation(fields:[id],references:[tenantId])
  identityMaps IdentityMap[] @relation(fields:[id],references:[tenantId])

  @@allow("read", auth() != null)
}

model Application {
  @use(AuditFields)

  id String @id
  tenantId String
  name String
  owner String?

  tenant Tenant @relation(fields:[tenantId],references:[id])
  environments Environment[] @relation(fields:[id],references:[applicationId])

  @@unique([tenantId, name])
  @@paged
  @@allow("create", auth() != null)
  @@allow("read", auth() != null)
  @@allow("update", auth() != null)
}

// `tenantId` here is derivable through `application.tenantId`, but every
// model in this registry carries its own `tenantId` (ADR-0001's comment
// above) so every table has one column to filter on -- Environment is no
// exception, and its own `@relation` (like Integration/IdentityMap's, #16)
// is what gets that FK actually enforced (cratestack still doesn't emit one
// for a bare `tenantId` field -- see the migration comment, cratestack/
// cratestack#260).
model Environment {
  @use(AuditFields)

  id String @id
  tenantId String
  applicationId String
  name String

  tenant Tenant @relation(fields:[tenantId],references:[id])
  application Application @relation(fields:[applicationId],references:[id])
  integrations Integration[] @relation(fields:[id],references:[environmentId])

  @@unique([tenantId, applicationId, name])
  @@paged
  @@allow("create", auth() != null)
  @@allow("read", auth() != null)
  @@allow("update", auth() != null)
}

// One credential per integration. Only a SHA-256 hash is stored -- the
// plaintext secret is returned once at issuance and is not recoverable.
// SHA-256 (not argon2id/bcrypt) on purpose: the secret is a 256-bit
// CSPRNG-generated value, not a human-chosen password, so a slow/memory-hard
// hash buys nothing against brute-force and only adds latency to every
// /internal/v1/resolve cache miss (ADR-0006's gateway hot path) -- and SHA-256
// allows a direct `WHERE credential_hash = sha256(presented)` lookup, since
// unlike argon2id/bcrypt it has no per-hash random salt. Matches
// lightbridge-authz's `ApiKey`/`createApiKey` precedent exactly (#10).
//
// Revocation is a `status` flip that /internal/v1/resolve reads, so it is
// authoritative and server-side (ADR-0006). That endpoint caches for 60s
// (ADR-0006, docs/runbooks/revoke-an-integration-token.md) -- that IS the
// revocation SLA, decided there, not re-litigated here.
//
// `credentialHash` is `@server_only`: it must never appear in a generated
// create/update input OR a read/output response -- a caller could otherwise
// mint their own token, or the hash could leak over the wire. `credentialPrefix`
// is `@readonly` (display only, e.g. "token starting with gov_a1b2c3d4" in a
// listing) -- it plays no role in verification. Issuance and revocation go
// through the `issueIntegrationCredential`/`revokeIntegrationCredential`
// procedures, since both need to touch fields no generated create/update can.
model Integration {
  @use(AuditFields)

  id String @id
  tenantId String
  applicationId String
  environmentId String
  provider String
  credentialPrefix String @readonly
  credentialHash String @server_only
  status String @readonly
  contentCapture String
  lastTelemetryAt DateTime?
  lastUsedAt DateTime? @readonly
  revokedAt DateTime? @readonly

  tenant Tenant @relation(fields:[tenantId],references:[id])
  application Application @relation(fields:[applicationId],references:[id])
  environment Environment @relation(fields:[environmentId],references:[id])

  @@paged
  @@allow("read", auth() != null)
}

// `environmentId`, not a free-form `environment` string (its shape before
// the Environment model existed, #10's original design) -- now that
// Environment is a first-class, registered resource, issuance should
// reference a real one rather than let a typo mint a credential under an
// environment nothing else agrees exists.
type IssueIntegrationCredentialInput {
  applicationId String
  provider String
  environmentId String
  contentCapture String?
}

// Nests `Integration` directly (matching `ApiKeySecret`'s shape in
// lightbridge-authz) -- the caller gets the full record plus the one-time
// plaintext, never separately re-fetchable after this response.
type IntegrationCredential {
  integration Integration
  secret String
}

// `tenantId` is deliberately absent from the input -- derived server-side from
// `applicationId` inside the procedure, never trusted from the request body
// (same reasoning as `createApiKey`'s `projectId` in lightbridge-authz).
// `@allow(auth() != null)` only asserts an authenticated caller; there is no
// ownership/ACL check yet (no equivalent of lightbridge-authz's project-lead
// gating exists in this registry today) -- any authenticated caller may issue
// a credential for any application, for now.
mutation procedure issueIntegrationCredential(args: IssueIntegrationCredentialInput): IntegrationCredential
  @allow(auth() != null)

type RevokeIntegrationCredentialInput {
  integrationId String
}

mutation procedure revokeIntegrationCredential(args: RevokeIntegrationCredentialInput): Integration
  @allow(auth() != null)

// Provider principal -> internal identity. Deliberately NOT matched on display
// name: verified email or an explicit mapping only.
model IdentityMap {
  @use(AuditFields)

  id String @id
  tenantId String
  provider String
  providerUserId String
  internalUserId String?
  teamId String?
  costCenterId String?
  mappingSource String
  validFrom DateTime @default(dbgenerated())
  validTo DateTime?

  tenant Tenant @relation(fields:[tenantId],references:[id])

  @@unique([tenantId, provider, providerUserId, validFrom])
  @@paged
  @@allow("read", auth() != null)
}

// ────────────────────────────────────────────────────────────────────────────
// Ingestion bookkeeping
// ────────────────────────────────────────────────────────────────────────────

// One row per (day, report). This is what makes reprocessing idempotent -- and
// it is ALSO where the connector's operational metrics come from, because a
// CronJob pod cannot be scraped (ADR-0007). Reprocessing a day upserts this row
// rather than inserting a second one.
model IngestManifest {
  @use(AuditFields)

  id String @id
  tenantId String
  provider String
  scopeId String
  reportDay DateTime
  reportType String
  status String
  recordCount Int
  checksum String?
  schemaVersion Int
  startedAt DateTime @default(dbgenerated())
  completedAt DateTime?

  @@unique([tenantId, provider, scopeId, reportDay, reportType])
  @@paged
  @@allow("read", auth() != null)
}

// ────────────────────────────────────────────────────────────────────────────
// Telemetry: executions, model calls, tool calls (#30)
// ────────────────────────────────────────────────────────────────────────────
//
// The normalized model that every push connector writes into. One Execution
// per agent session/run, with ModelCall and ToolCall children. All money is
// micro-USD (ADR-0008). All writes are idempotent on (trace_id, span_id) --
// reprocessing the same telemetry must not change row counts.
//
// `tenantId` is on every row, derived from the authenticated integration
// credential and stamped by Authorino -- never read from the telemetry body
// (RFC-0002's trust boundary).

// One agent session/run. The top-level record that groups model calls and
// tool calls together. `traceId` + `spanId` are the OpenTelemetry identity --
// the deterministic key for idempotent upsert.
model Execution {
  @use(AuditFields)

  id String @id
  tenantId String
  integrationId String
  provider String
  traceId String
  spanId String
  userEmail String?
  startedAt DateTime
  durationMs Int
  // NULL = cost unknown (no pricing row, or a model call with unknown token
  // counts). Unknown is honest; a zero would be indistinguishable from "free".
  estimatedCostMicroUsd Int?
  rawBackend String?
  rawSchemaVersion Int

  modelCalls ModelCall[] @relation(fields:[id],references:[executionId])
  toolCalls ToolCall[] @relation(fields:[id],references:[executionId])

  @@unique([traceId, spanId])
  @@paged
  @@allow("read", auth() != null)
}

// One LLM call within an execution. Token counts and cost live here.
// `executionId` is the parent Execution; `traceId` + `spanId` are the
// OpenTelemetry identity for idempotent upsert. `inputTokens`/`outputTokens`
// and `costMicroUsd` are nullable: a call whose token counts are unknown is
// stored with NULL cost (unknown), never a zero (which a dashboard would read
// as "free").
model ModelCall {
  @use(AuditFields)

  id String @id
  executionId String
  traceId String
  spanId String
  model String
  inputTokens Int?
  outputTokens Int?
  costMicroUsd Int?

  execution Execution @relation(fields:[executionId],references:[id])

  @@unique([traceId, spanId])
  @@paged
  @@allow("read", auth() != null)
}

// One tool invocation within an execution. No cost -- tools are metered by
// the model call that invoked them, not independently.
model ToolCall {
  @use(AuditFields)

  id String @id
  executionId String
  traceId String
  spanId String
  toolName String
  durationMs Int

  execution Execution @relation(fields:[executionId],references:[id])

  @@unique([traceId, spanId])
  @@paged
  @@allow("read", auth() != null)
}

// Per-model pricing. `inputPerMillionMicroUsd` and `outputPerMillionMicroUsd`
// are the cost in micro-USD per million tokens. Cost for a ModelCall is:
//   (inputTokens * inputPerMillionMicroUsd + outputTokens * outputPerMillionMicroUsd) / 1_000_000
// All arithmetic stays integral (ADR-0008).
model ModelPricing {
  @use(AuditFields)

  id String @id
  model String
  inputPerMillionMicroUsd Int
  outputPerMillionMicroUsd Int
  effectiveFrom DateTime @default(dbgenerated())
  effectiveTo DateTime?

  @@unique([model, effectiveFrom])
  @@paged
  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
}

// ────────────────────────────────────────────────────────────────────────────
// Telemetry ingest (#30)
// ────────────────────────────────────────────────────────────────────────────
//
// Ingestion is deliberately NOT a schema procedure. The OpenTelemetry
// Collector pushes OTLP over plain HTTP JSON -- it cannot be taught CBOR, the
// same constraint that keeps `/internal/v1/resolve` off this router (ADR-0009,
// and the schema comment on `IngestManifest`). The ingest path is therefore a
// hand-written `/internal/v1/ingest` route (merged alongside resolve in
// `main.rs`) that calls `governance_core::ingest::ingest_telemetry`; that
// function is the single persistence entry point, its raw SQL being the
// sanctioned escape hatch for a procedure body (ADR-0009, matching
// `credential::issue`). The tables below are the normalized model it writes.
