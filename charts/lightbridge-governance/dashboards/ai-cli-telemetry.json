  "links": [
    {
      "type": "link",
      "title": "Export PNG",
      "icon": "external link",
      "url": "/render/d/governance-ai-cli-telemetry?width=1280&height=-1&scale=1&fullPageImage=true&kiosk=true&hideNav=true&timeout=180",
      "targetBlank": true,
      "keepTime": true,
      "includeVars": true,
      "tooltip": "Full dashboard image; allow up to 3 minutes. Uses the selected time range and filters."
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Source dashboards",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**[Claude Code](/d/governance-claude-code-telemetry)** \u2014 Cost, tokens, tools and reliability.\n\n**[Codex](/d/governance-codex-telemetry)** \u2014 Tokens, latency, tool decisions and reliability.\n\n**[OpenCode](/d/governance-opencode-telemetry)** \u2014 Client-reported usage, tools and errors.\n\n**[VS Code Copilot](/d/governance-vscode-copilot)** \u2014 Editor sessions, code edits and acceptance.\n\n**[Copilot reports & seats](/d/governance-copilot-connector)** \u2014 GitHub reports, assigned seats and pull-job health."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Claude Code logs",
      "description": "Log records observed in the hour ending at the selected time. No recent logs can mean the client is idle, unconfigured, or failing; it is not a health verdict.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOKI__"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No recent logs",
                  "color": "gray"
                },
                "1": {
                  "text": "Receiving logs",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "expr": "(sum(count_over_time({job=~\"claude-code-desktop|ai-cli/claude-code-desktop\"}[1h])) or vector(0)) > bool 0",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
