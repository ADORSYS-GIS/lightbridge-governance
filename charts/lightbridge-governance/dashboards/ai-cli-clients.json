{
  "uid": "governance-ai-cli-clients",
  "title": "AI CLI clients",
  "description": "Which AI coding clients talk to the gateway, through which credential, and how well. Sourced from envoy-ai-gateway access logs in Loki -- the same stream the envoy-ai-gateway-* dashboards use, grouped by client rather than by user. Companion to the ai-cli OTLP collector: this shows the INFERENCE side (which always works), while the collector carries the TELEMETRY side.",
  "tags": [
    "governance",
    "ai-cli",
    "adoption"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Which AI clients are being used",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests",
      "description": "Every request the gateway served in range, all clients.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOKI__"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"envoy-ai-gateway\"} [$__range]))",
          "queryType": "range",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Distinct clients",
      "description": "Distinct user-agent strings. Each CLI version counts separately -- opencode ships many versions, so this runs higher than 'distinct tools'.",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOKI__"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "count(sum by (user_agent) (count_over_time({service_name=\"envoy-ai-gateway\"} | json user_agent=`[\"user-agent\"]` [$__range])))",
          "queryType": "range",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
