          "editorMode": "code",
          "expr": "sort_desc(sum by (user_agent) (sum_over_time({service_name=\"envoy-ai-gateway\"} | json user_agent=`[\"user-agent\"]`, tot=`[\"gen_ai.usage.total_tokens\"]` | unwrap tot | __error__=\"\" [$__range])))",
          "queryType": "range",
          "legendFormat": "",
