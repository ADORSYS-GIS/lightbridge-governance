    {
      "type": "timeseries",
      "title": "Non-2xx responses by client",
      "description": "Client-visible failures. A 404 here is usually a model the gateway does not serve -- Claude Code's built-in default model produces exactly this, since it does not exist upstream.",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOKI__"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "sum by (user_agent, code) (count_over_time({service_name=\"envoy-ai-gateway\"} | json user_agent=`[\"user-agent\"]`, code=`response_code` | code!~\"2..\" [1m]))",
          "queryType": "range",
          "legendFormat": "{{user_agent}} {{code}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
