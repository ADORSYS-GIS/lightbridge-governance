      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=\"envoy-ai-gateway\"} | json tot=`[\"gen_ai.usage.total_tokens\"]` | unwrap tot | __error__=\"\" [$__range]))",
          "queryType": "range",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
