    {
      "type": "timeseries",
      "title": "Requests by client",
      "description": "Adoption over time, per client. This is the panel that shows a new client (Claude Code via governance-auth) appearing against the established ones.",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "__DS_LOKI__"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "sum by (user_agent) (count_over_time({service_name=\"envoy-ai-gateway\"} | json user_agent=`[\"user-agent\"]` [1m]))",
          "queryType": "range",
          "legendFormat": "{{user_agent}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Clients by request count",
      "description": "Ranked client list for the selected range.",
