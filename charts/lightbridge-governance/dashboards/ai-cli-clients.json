            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Tokens by client",
      "description": "Consumption, not just call count -- a client with few calls can still dominate spend.",
      "id": 8,
      "datasource": {
