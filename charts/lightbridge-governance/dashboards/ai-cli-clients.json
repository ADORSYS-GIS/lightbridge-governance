          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__DS_LOKI__"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (user_agent) (count_over_time({service_name=\"envoy-ai-gateway\"} | json user_agent=`[\"user-agent\"]` [$__range])))",
          "queryType": "range",
          "legendFormat": "",
