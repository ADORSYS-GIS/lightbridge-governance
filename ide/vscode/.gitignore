# npm and the bundler live entirely inside this directory. Nothing at CI or
# deploy time for the Rust workspace runs either -- the same fencing the
# dashboard generator gets in the root .gitignore. If a release job is ever
# added for this extension, that fence stops holding and the claim in
# CLAUDE.md ("there is no npm here") needs revisiting rather than quietly
# becoming false.
node_modules/
dist/
*.vsix
