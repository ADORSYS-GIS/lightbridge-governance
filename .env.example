# redact-gateway holds no credential of its own (see app/redact-gateway/src/main.rs
# module docs): the caller's Authorization header is forwarded upstream untouched.
# Supply a real API key per-request when you curl the gateway, e.g.:
#
#   curl http://localhost:8080/v1/chat/completions \
#     -H "Authorization: Bearer $YOUR_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"model":"...","messages":[{"role":"user","content":"hello"}]}'
#
# PROVIDER_BASE_URL is the provider's root — the gateway appends the caller's
# own path (e.g. /v1/chat/completions) unmodified, so do NOT include /v1 here.
#   OpenAI    https://api.openai.com
#   Groq      https://api.groq.com/openai
#   Together  https://api.together.xyz
PROVIDER_BASE_URL=https://api.openai.com

REDACT_HASH_SALT=dev-salt-change-in-prod
